    {
      "type": "table",
      "title": "Delivered plats \u2014 the ledger, generated",
      "description": "v_delivered_plats is the row shape a work-tracking ledger wants. roster_gap is the ledger's \u26a0 condition, as far as Plat can see it: a roster ticket never delivered as a plat of its own. It cannot see your issue tracker's status; cross-check there.",
      "datasource": {
        "type": "postgres",
        "uid": "plat-pg"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "plat-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT anchor, title, coalesce(array_length(roster,1),0) AS roster, started::text AS started, closed::text AS closed, lots, attempts, findings, spend, roster_gap FROM v_delivered_plats ORDER BY closed DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
