    {
      "type": "table",
      "title": "Decision record \u2014 blue is observed by the supervisor, orange is self-reported by an agent, red is you",
      "description": "One table, three actors, a tree via parent_id. A system decision is observed; an agent decision is self-reported and weaker evidence. Long rationales are truncated here \u2014 click a cell to inspect, or read the record end to end with `plat show <anchor>`.",
      "datasource": {
        "type": "postgres",
        "uid": "plat-pg"
      },
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "plat-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(ts,'HH24:MI:SS') AS at, repeat('    ', depth) || actor AS actor, actor_detail, kind, decision, rationale, array_to_string(ARRAY(SELECT jsonb_array_elements_text(alternatives)), ' \u00b7 ')   AS alternatives FROM v_decision_tree ORDER BY path",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "actor"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "system": {
                        "color": "blue",
                        "index": 0
                      },
                      "agent": {
                        "color": "orange",
                        "index": 1
                      },
                      "human": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rationale"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 420
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "decision"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alternatives"
            },
            "properties": []
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false
        }
      },
      "id": 9
    },
