    {
      "type": "table",
      "title": "Live lots",
      "description": "Derived signals come from v_live_lots, not from this panel \u2014 so the terminal, Grafana and anything built later agree by construction. 'stale' is relative to the median duration of that phase in that repo.",
      "datasource": {
        "type": "postgres",
        "uid": "plat-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "plat-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ticket, lot, state, phase, agent, attempt AS att, extract(epoch from elapsed)::int AS elapsed_s, cost, stale, retrying, needs_human, permission_denials AS denials, round(typical_s) AS typical_s FROM v_live_lots ORDER BY needs_human DESC, stale DESC, ticket, lot",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "DONE": {
                        "color": "green",
                        "index": 0
                      },
                      "BLOCKED": {
                        "color": "red",
                        "index": 1
                      },
                      "CODING": {
                        "color": "blue",
                        "index": 2
                      },
                      "REVIEWING": {
                        "color": "orange",
                        "index": 3
                      },
                      "GATE": {
                        "color": "purple",
                        "index": 4
                      },
                      "PENDING": {
                        "color": "text",
                        "index": 5
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "elapsed_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "typical_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "stale"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "color": "red",
                        "text": "yes",
                        "index": 0
                      },
                      "false": {
                        "color": "text",
                        "text": "\u00b7",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "retrying"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "color": "red",
                        "text": "yes",
                        "index": 0
                      },
                      "false": {
                        "color": "text",
                        "text": "\u00b7",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "needs_human"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "color": "red",
                        "text": "yes",
                        "index": 0
                      },
                      "false": {
                        "color": "text",
                        "text": "\u00b7",
                        "index": 1
                      }
                    }
